#!/bin/bash
#SBATCH --job-name=cuda-8k-scale
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=4
#SBATCH --time=00:30:00
#SBATCH --account=brics.s5e
#SBATCH --output=logs/large_scale_%j.out
#SBATCH --error=logs/large_scale_%j.out

set -euo pipefail

WORKDIR=/lus/lfs1aip2/projects/s5e/quant/AlphaTrade/experiments/exp_M1_cuda_matching

echo "=== CUDA V2 Large-Scale Benchmark ==="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node:   $(hostname)"
echo "GPUs:   $(nvidia-smi -L 2>/dev/null | wc -l)"
echo "Date:   $(date)"
echo "======================================"

export CONDA_PREFIX=/projects/s5e/quant/miniforge3
export PATH=$CONDA_PREFIX/bin:$PATH
module load cuda/12.6
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cudnn/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nccl/lib:${LD_LIBRARY_PATH:-}

export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85

echo "Python: $(which python) ($(python --version 2>&1))"
echo "nvcc: $(nvcc --version 2>&1 | tail -1)"
echo ""

cd "${WORKDIR}"

# Build kernels
echo "=== Building CUDA kernels ==="
cd gymnax_exchange/jaxob/cuda_matching
bash build.sh
cd "${WORKDIR}"
echo ""

# Run large-scale benchmark
echo "=== Large-Scale Benchmark ==="
python test_large_scale.py
echo ""

echo "=== Done: $(date) ==="
